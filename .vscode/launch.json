{
    "configurations": [
        {
            "name": "Development",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "my_kanban",
                "FLASK_DEBUG": "1",
                "FLASK_CONFIG": "development"
            },
            "args": [
                "run",
            ],
            "jinja": true
        },
        {
            "name": "Demo",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "my_kanban",
                "FLASK_CONFIG": "demo"
            },
            "args": [
                "run",
                "--no-debugger"
            ],
            "jinja": true
        }
    ]
}